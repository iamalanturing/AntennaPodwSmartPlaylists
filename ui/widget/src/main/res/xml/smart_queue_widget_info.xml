<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="de.danoeh.antennapod.ui.widget.SmartQueueWidgetConfigActivity"
    android:initialLayout="@layout/smart_queue_widget"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/ic_widget_preview"
    android:previewLayout="@layout/smart_queue_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="86400000"
    android:widgetFeatures="reconfigurable"
    tools:targetApi="31" />
